{
  "expo": {
    "name": "OxiMux",
    "slug": "oximux",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "oximux",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "sh.oximux.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "sh.oximux.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#15171A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OxiMux uses the camera only to scan the pairing QR code shown by your desktop."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OxiMux uses your photo library only to attach images to a prompt you send to your desktop."
        }
      ],
      "./plugins/with-system-configuration",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15171A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "OxiMux uses the microphone only to dictate a prompt, which your desktop transcribes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf9437bf-8dc0-4f2c-a08a-0a5f924124b0"
      }
    },
    "owner": "nhtera"
  }
}
