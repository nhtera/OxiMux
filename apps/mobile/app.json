{
  "expo": {
    "name": "OxiMux",
    "slug": "oximux",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "oximux",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "sh.oximux.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "sh.oximux.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "OxiMux uses the camera only to scan the pairing QR code shown by your desktop."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OxiMux uses your photo library only to attach images to a prompt you send to your desktop."
        }
      ],
      "./plugins/with-system-configuration",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
