{
  "name": "@oximux/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "LANG=${LANG:-en_US.UTF-8} expo run:android",
    "ios": "LANG=${LANG:-en_US.UTF-8} expo run:ios",
    "prebuild": "LANG=${LANG:-en_US.UTF-8} expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "bindings": "npm run ubrn:ios --prefix modules/oximux-core",
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs && node scripts/generate-xterm-bundle.mjs",
    "eas-build-post-install": "node scripts/build-rust-core-for-eas.mjs",
    "xterm:bundle": "node scripts/generate-xterm-bundle.mjs",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@ubjs/core": "0.31.0-3",
    "@xterm/xterm": "^6.0.0",
    "expo": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "lucide-react-native": "^1.26.0",
    "oximux-core": "file:./modules/oximux-core",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-code-highlighter": "^1.3.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-marked": "^8.1.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "react-syntax-highlighter": "^16.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
