{
  // Workers static assets, matching how erai.dev itself is deployed.
  //
  // There is no `main` here: the site is `output: "static"` with no adapter, so
  // this is an assets-only Worker. Wrangler serves ./dist directly, and because
  // erai.dev is a zone on this account it also creates the DNS record and cert
  // for the custom domain below. That is the reason this is a Worker rather
  // than a Pages project: `wrangler pages` has no custom-domain command, so a
  // Pages deploy would leave the domain to be wired by hand in the dashboard.
  "name": "oximux-landing",
  "compatibility_date": "2026-07-26",
  "routes": [{ "pattern": "oximux.erai.dev", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
