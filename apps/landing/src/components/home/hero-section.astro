---
import { Icon } from "astro-icon/components";
import CliInstallDialog from "./cli-install-dialog.astro";
import DownloadDetect from "./download-detect.astro";
import ShotFrame from "../shot-frame.astro";
import { SITE, AGENT_MARKS } from "../../consts";
import cockpit from "../../assets/shots/cockpit.png";
---

<!--
  Asymmetric hero: copy is left-weighted rather than centred, and the capture
  runs wider than the text column beneath it. Four text elements at most, so
  there is no eyebrow, no trust strip, and no tagline under the buttons.

  The headline wipes in line by line and the caret keeps blinking after it
  lands, which is the page introducing itself in the product's own idiom.
-->
<section class="px-5 pt-16 pb-14 sm:px-8 sm:pt-24 sm:pb-20">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal>
      <!--
        Mono display runs roughly 15% wider per character than sans at the same
        size, so this tops out a step below where a sans hero would. At 6xl the
        second line alone spans the full measure and stops reading as a
        headline.
      -->
      <h1
        class="font-mono text-3xl leading-[1.08] font-semibold tracking-tight text-fg sm:text-4xl lg:text-5xl"
      >
        {
          SITE.heroLines.map((line, i) => (
            <span class="line-clip" style={`--i: ${i}`}>
              <span>
                {line}
                {i === SITE.heroLines.length - 1 && (
                  <>
                    {" "}
                    <span class="caret" aria-hidden="true" />
                  </>
                )}
              </span>
            </span>
          ))
        }
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-fg-muted">
        Spawn isolated worktrees, run Claude Code, Codex, and Pi in parallel,
        review every diff. Rust and GPUI.
      </p>

      <!--
        One download button, matched to the visitor's OS. The markup ships the
        Mac state — primary Mac button, "Also for Windows" line below — as the
        majority audience and the no-JS fallback; download-detect.astro swaps
        the visible pieces for Windows and Linux visitors. Visibility is inline
        `display`, never Tailwind's `hidden`: the compiled sheet orders .hidden
        before .inline-flex, so on these elements the class loses the cascade
        and does nothing.

        Both download anchors hit permanent releases/latest/download URLs, so
        a click starts the right file directly.
      -->
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={SITE.downloads.mac}
          data-dl="mac"
          class="press inline-flex items-center gap-2 rounded-[--radius-control] bg-fg px-5 py-3 text-sm font-medium whitespace-nowrap text-canvas hover:bg-white"
        >
          <Icon name="simple-icons:apple" class="size-4" aria-hidden="true" />
          Download for Mac
        </a>

        <a
          href={SITE.downloads.windows}
          data-dl="windows"
          style="display: none"
          class="press inline-flex items-center gap-2 rounded-[--radius-control] bg-fg px-5 py-3 text-sm font-medium whitespace-nowrap text-canvas hover:bg-white"
        >
          <Icon name="ph:windows-logo" class="size-4" aria-hidden="true" />
          Download for Windows
        </a>

        <!--
          Linux visitors get a state chip instead of a download: there is no
          Linux desktop build yet, and the chip says so the same way the iOS
          one does.
        -->
        <span
          data-dl="linux-soon"
          style="display: none"
          class="inline-flex items-center gap-2 rounded-[--radius-control] border border-edge px-4 py-3 text-sm whitespace-nowrap text-fg-muted"
        >
          <Icon name="ph:linux-logo" class="size-4" aria-hidden="true" />
          Linux
          <span
            class="rounded-[--radius-chip] bg-panel-alt px-1.5 py-0.5 text-[11px] tracking-wide text-fg-subtle"
          >
            Soon
          </span>
        </span>

        <!--
          iOS is a real client but is not distributed yet, so this is a state
          chip rather than a link. A disabled anchor would still look clickable
          and would land the reader nowhere; a span with the status spelled out
          cannot mislead.
        -->
        <span
          class="inline-flex items-center gap-2 rounded-[--radius-control] border border-edge px-4 py-3 text-sm whitespace-nowrap text-fg-muted"
        >
          <Icon name="ph:device-mobile" class="size-4" aria-hidden="true" />
          iOS
          <span
            class="rounded-[--radius-chip] bg-panel-alt px-1.5 py-0.5 text-[11px] tracking-wide text-fg-subtle"
          >
            Soon
          </span>
        </span>

        <!--
          The CLI's door into the page: an icon-only trigger that opens the
          install dialog. Icon-sized like the GitHub button beside it — the
          hero keeps one primary action, and these two stay secondary.
        -->
        <CliInstallDialog />

        <a
          href={SITE.repo}
          aria-label="GitHub"
          class="press inline-flex items-center justify-center rounded-[--radius-control] border border-edge bg-panel p-3 text-fg hover:border-edge-strong hover:bg-panel-alt"
        >
          <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
        </a>
      </div>

      <!--
        The other platform's direct download, one line, Orca-compact. Default
        shows "Also for Windows"; download-detect.astro flips it to macOS for
        Windows visitors and shows both for Linux ones. Real anchors, so the
        no-JS fallback still reaches every installer.
      -->
      <p class="mt-3 flex flex-wrap items-center gap-x-1.5 text-sm text-fg-subtle">
        <span>Also for</span>
        <a
          href={SITE.downloads.mac}
          data-dl-alt="mac"
          style="display: none"
          class="underline decoration-edge-strong underline-offset-4 hover:text-fg"
        >macOS</a>
        <span data-dl-alt-sep style="display: none">·</span>
        <a
          href={SITE.downloads.windows}
          data-dl-alt="windows"
          class="underline decoration-edge-strong underline-offset-4 hover:text-fg"
        >Windows</a>
      </p>

      <!--
        Compatibility strip, not a trust badge: naming the agents is how a
        reader confirms in two seconds that this drives the CLI they already
        pay for. Marks are the desktop app's own monochrome glyphs.
      -->
      <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3">
        <span class="text-sm text-fg-subtle">Supports</span>
        <ul class="flex flex-wrap items-center gap-4">
          {
            AGENT_MARKS.map((agent) => (
              <li class="flex items-center" title={agent.name}>
                <Icon
                  name={agent.icon}
                  class="size-5 text-fg-muted transition-colors duration-200 hover:text-fg motion-reduce:transition-none"
                  aria-hidden="true"
                />
                <span class="sr-only">{agent.name}</span>
              </li>
            ))
          }
        </ul>
        <span class="text-sm text-fg-subtle">and any ACP agent</span>
      </div>
    </div>

    <DownloadDetect />

    <div class="scroll-lift mt-14 sm:mt-16">
      <ShotFrame
        src={cockpit}
        priority
        alt="The OxiMux cockpit: project rail on the left, agent and terminal tabs across the top, and the source control panel on the right showing changed files and the commit graph."
      />
    </div>
  </div>
</section>
