---
import ShotFrame from "../shot-frame.astro";
import diff from "../../assets/shots/diff.png";

const points = [
  "Staged and unstaged review with word-level diffs",
  "Commit graph, branch picker, stash, and conflict banners",
  "Commit messages drafted by an agent, edited by you",
  "Push, pull, sync, CI status, and pull request creation",
];
---

<section class="border-t border-edge px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2
        class="font-mono text-2xl leading-tight font-semibold tracking-tight text-balance text-fg sm:text-3xl"
      >
        Git is the trust layer.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-fg-muted">
        An agent that edits your repository is only useful if you can see what
        it did. Every change lands as reviewable git state before it goes
        anywhere.
      </p>
      <ul class="mt-8">
        {
          points.map((point, i) => (
            <li
              data-reveal
              style={`--i: ${i}`}
              class="row-sweep border-t border-edge px-2 py-3.5 text-sm leading-relaxed text-fg last:border-b"
            >
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <div data-reveal>
      <!-- Ratio matches the crop exactly so object-cover never has anything to
           trim. The capture is deliberately narrowed to the changed-file list
           plus the diff pane: the rail and the source control panel already
           appear in the two shots above, and dropping them here keeps the diff
           text legible at column width. -->
      <ShotFrame
        src={diff}
        ratio="2020 / 1810"
        alt="The diff viewer showing two changed files, a word-level diff with added and removed line tints, and collapsed unchanged-line runs."
      />
    </div>
  </div>
</section>
