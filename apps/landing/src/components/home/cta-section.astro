---
import { Icon } from "astro-icon/components";
import DownloadDetect from "./download-detect.astro";
import { SITE } from "../../consts";
---

<section class="border-t border-edge px-5 py-24 sm:px-8 sm:py-32">
  <div
    class="mx-auto flex max-w-2xl flex-col items-center text-center"
    data-reveal
  >
    <!-- No data-reveal here: the wrapper above already carries it, and nesting
         two reveal targets double-hides this heading. -->
    <h2
      class="font-mono text-2xl leading-tight font-semibold tracking-tight text-balance text-fg sm:text-4xl"
    >
      Run your agents on something native.
    </h2>
    <p class="mt-5 max-w-md text-base leading-relaxed text-fg-muted">
      Pre-1.0 and in active development. It is already what OxiMux itself gets
      built with.
    </p>

    <!--
      Same intents as the hero, same labels, same direct-download URLs, and the
      same data-dl markers so download-detect.astro swaps to the visitor's own
      platform here too (inline display, not `hidden` — see the hero comment).
      The repo link is called "GitHub" everywhere on the page, so no single
      intent picks up a second name.
    -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={SITE.downloads.mac}
        data-dl="mac"
        class="press inline-flex items-center gap-2 rounded-[--radius-control] bg-fg px-6 py-3 text-sm font-medium whitespace-nowrap text-canvas hover:bg-white"
      >
        <Icon name="simple-icons:apple" class="size-4" aria-hidden="true" />
        Download for Mac
      </a>
      <a
        href={SITE.downloads.windows}
        data-dl="windows"
        style="display: none"
        class="press inline-flex items-center gap-2 rounded-[--radius-control] bg-fg px-6 py-3 text-sm font-medium whitespace-nowrap text-canvas hover:bg-white"
      >
        <Icon name="ph:windows-logo" class="size-4" aria-hidden="true" />
        Download for Windows
      </a>
      <span
        data-dl="linux-soon"
        style="display: none"
        class="inline-flex items-center gap-2 rounded-[--radius-control] border border-edge px-4 py-3 text-sm whitespace-nowrap text-fg-muted"
      >
        <Icon name="ph:linux-logo" class="size-4" aria-hidden="true" />
        Linux
        <span
          class="rounded-[--radius-chip] bg-panel-alt px-1.5 py-0.5 text-[11px] tracking-wide text-fg-subtle"
        >
          Soon
        </span>
      </span>
      <a
        href={SITE.repo}
        class="press inline-flex items-center gap-2 rounded-[--radius-control] border border-edge bg-panel px-6 py-3 text-sm whitespace-nowrap text-fg hover:border-edge-strong hover:bg-panel-alt"
      >
        <Icon name="simple-icons:github" class="size-4" aria-hidden="true" />
        GitHub
      </a>
    </div>

    <p class="mt-3 flex flex-wrap items-center justify-center gap-x-1.5 text-sm text-fg-subtle">
      <span>Also for</span>
      <a
        href={SITE.downloads.mac}
        data-dl-alt="mac"
        style="display: none"
        class="underline decoration-edge-strong underline-offset-4 hover:text-fg"
      >macOS</a>
      <span data-dl-alt-sep style="display: none">·</span>
      <a
        href={SITE.downloads.windows}
        data-dl-alt="windows"
        class="underline decoration-edge-strong underline-offset-4 hover:text-fg"
      >Windows</a>
    </p>

    <DownloadDetect />
  </div>
</section>
